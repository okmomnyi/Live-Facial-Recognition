# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` for local docker-compose development:
#   cp .env.example .env
# The values below are the docker-compose defaults and work out of the box.
# ---------------------------------------------------------------------------

# Postgres connection (async SQLAlchemy scheme). In docker-compose the host is
# the service name `db`. For Neon, swap `postgresql://` -> `postgresql+asyncpg://`
# and use the pooled (`-pooler`) connection string.
DATABASE_URL=postgresql+asyncpg://lfr:lfr_dev_password@db:5432/lfr

# Where the pipeline writes reference crops and alert captures.
DATA_DIR=/data

# --- Face pipeline tuning ---------------------------------------------------
DET_THRESHOLD=0.5            # min SCRFD detection score to keep a face
MIN_FACE_SIZE=80             # min face bbox width/height in px
MATCH_THRESHOLD=0.42         # cosine similarity >= this counts as a match
FRAME_SKIP=5                 # process every Nth video frame
ALERT_COOLDOWN_SECONDS=30    # suppress repeat alerts per (person, camera)
CONSENSUS_FRAMES=3           # matches needed across frames to fire an alert
CONSENSUS_WINDOW_SECONDS=5   # window over which consensus frames must occur

# CORS: the origin the React dev server / deployed frontend is served from.
FRONTEND_ORIGIN=http://localhost:5173
